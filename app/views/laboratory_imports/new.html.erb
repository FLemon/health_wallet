<div class="import-container">
  <%= link_to "← Back to Patients", patients_path, class: "back-link" %>
  <h1>Import laboratory results</h1>
  <p>Upload a pipe-delimited HL7 text file. The import will run in the background.</p>

  <%= form_with model: @laboratory_import, class: "import-form" do |form| %>
    <% if @laboratory_import.errors.any? %>
      <div class="flash-error"><%= @laboratory_import.errors.full_messages.to_sentence %></div>
    <% end %>
    <%= form.label :file, "Laboratory results file" %>
    <%= form.file_field :file, accept: ".txt,text/plain", required: true %>
    <%= form.submit "Upload and import", class: "btn" %>
  <% end %>
</div>
